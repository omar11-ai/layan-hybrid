# Firebase web app config - Firebase console > Project settings > Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check - console > App Check > Apps > Manage debug tokens
# The debug token is generated locally and registered in the console.
# It is never committed to git.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
VITE_FIREBASE_APPCHECK_SITE_KEY=
