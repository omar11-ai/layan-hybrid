rules_version = '2';

// LAYAN stores engagement sessions and their indicator timelines so a
// second operator can pick up an engagement from another device.
//
// Every session belongs to the signed-in operator. Anonymous sign-in is used
// on the client, so the auth check is the only identity boundary.
service cloud.firestore {
  match /databases/{database}/documents {

    match /sessions/{sessionId} {
      allow read, write: if request.auth != null
        && (resource == null || resource.data.operatorUid == request.auth.uid);
    }

    match /operators/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    // Everything else is closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
